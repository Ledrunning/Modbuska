<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Packaging Properties (kept for later; the package is not published yet) -->
		<PackageId>Modbuska.ModbusManager</PackageId>
		<Version>0.1.0-alpha</Version>
		<Authors>Osman Mazinov</Authors>
		<Description>Modbus RTU master library for .NET. Supports FC1-6, 15 and 16 with strict response validation, designed for quick testing and prototyping over serial ports.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Ledrunning/Modbuska</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>modbus;modbus-rtu;serialport;rs485;automation;iot</PackageTags>

		<!-- XML docs and Source Link -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/>
        <PackageReference Include="System.IO.Ports" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false"/>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

</Project>
