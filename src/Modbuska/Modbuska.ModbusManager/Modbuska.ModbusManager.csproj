<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet Packaging Properties -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Modbuska.ModbusManager</PackageId>
        <Version>1.0.0</Version>
        <Authors>Osman Mazinov</Authors>
        <Company>Industrial Automation</Company>
        <Description>High-performance modern .NET 8 Modbus RTU client library for industrial IoT and automation.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/your-username/Modbuska</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>modbus;modbus-rtu;iot;automation;serialport</PackageTags>

        <!-- Symbols and Source Link -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.6"/>
        <PackageReference Include="System.IO.Ports" Version="9.0.6"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false"/>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

</Project>
