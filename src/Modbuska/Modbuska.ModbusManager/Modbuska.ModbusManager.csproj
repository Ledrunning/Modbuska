<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Modbuska.ModbusManager</PackageId>
        <Version>0.1.0</Version>
        <Authors>Osman Mazinov</Authors>
        <Company>-/-</Company>
        <Description>Lightweight .NET library for Modbus RTU communication over serial ports with DI registration support.</Description>
        <PackageTags>modbus;modbus-rtu;serial;industrial;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/Ledrunning/Modbuska</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Ledrunning/Modbuska</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.6"/>
        <PackageReference Include="System.IO.Ports" Version="9.0.6"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false"/>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

</Project>
